{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerofactor.invalid/schemas/controlled-scope.schema.json",
  "title": "ZEROFACTOR Controlled Assessment Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "authorized",
    "owner",
    "target_url",
    "allowed_hosts",
    "expires_at",
    "modules"
  ],
  "properties": {
    "authorization_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "authorized": {
      "const": true
    },
    "owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HTTP_POSTURE",
          "AUTH",
          "INPUT",
          "FILE",
          "TLS",
          "RATE",
          "RECOVERY"
        ]
      }
    },
    "allowed_routes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 256
          },
          "method": {
            "enum": [
              "GET",
              "HEAD"
            ]
          },
          "expected_status": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "maxItems": 5
          }
        }
      }
    },
    "fixture_ids": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "request_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "default": 12
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 30
    }
  }
}
